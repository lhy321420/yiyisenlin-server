<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.CityPhotoMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO city_photo (province, city, url, user_id, create_time)
        VALUES (#{province}, #{city}, #{url}, #{userId}, #{createTime})
    </insert>

    <select id="selectById" resultType="com.example.demo.entity.CityPhoto">
        SELECT * FROM city_photo WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM city_photo WHERE id = #{id}
    </delete>

    <select id="selectByProvinceAndCity" resultType="com.example.demo.entity.CityPhoto">
        SELECT * FROM city_photo
        WHERE province = #{province} AND city = #{city}
        ORDER BY create_time DESC
    </select>
</mapper>