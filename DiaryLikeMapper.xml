<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.DiaryLikeMapper">
    <insert id="insert">
        INSERT INTO diary_like (diary_id, user_id) VALUES (#{diaryId}, #{userId})
    </insert>
    <delete id="delete">
        DELETE FROM diary_like WHERE diary_id = #{diaryId} AND user_id = #{userId}
    </delete>
    <select id="countByDiaryAndUser" resultType="int">
        SELECT COUNT(*) FROM diary_like WHERE diary_id = #{diaryId} AND user_id = #{userId}
    </select>
</mapper>