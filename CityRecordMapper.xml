<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.CityRecordMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO city_record (province, city, content, user_id, create_time)
        VALUES (#{province}, #{city}, #{content}, #{userId}, #{createTime})
    </insert>

    <select id="selectById" resultType="com.example.demo.entity.CityRecord">
        SELECT * FROM city_record WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM city_record WHERE id = #{id}
    </delete>

    <select id="selectByProvinceAndCity" resultType="com.example.demo.entity.CityRecord">
        SELECT * FROM city_record
        WHERE province = #{province} AND city = #{city}
        ORDER BY create_time DESC
    </select>
</mapper>